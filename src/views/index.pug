doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="theme-color", content="#f3f5ef")
        meta(name="description", content="Jair Gutierrez, desarrollador full stack especializado en React, Python y .NET.")
        title Jair Gutierrez | Desarrollador Full Stack
        link(rel="preconnect", href="https://fonts.googleapis.com")
        link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin="anonymous")
        link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Manrope:wght@400;700;800&display=swap")
        link(rel="stylesheet", href="/css/style.css")
    body
        header.topbar.shell
            a.brand(href="/", aria-label="Jair Gutierrez, inicio")
                span.brand-mark(aria-hidden="true") JG
                span Jair Gutierrez
            a.nav-link(href="/projects") Aplicaciones

        main
            section.hero.shell(id="inicio", aria-labelledby="hero-title")
                div
                    p.eyebrow
                        span.status-dot(aria-hidden="true")
                        | Desarrollador full stack
                    h1#hero-title
                        | Ideas claras.
                        br
                        | Software que
                        | &nbsp;
                        span responde.
                    p.intro
                        | Soy Jair, desarrollador
                        | &nbsp;
                        strong backend y frontend
                        | . Conecto buenas experiencias con sistemas sólidos usando React, Python y .NET.

                .code-scene
                    .code-window
                        .window-top
                            span.window-dots(aria-hidden="true")
                                i
                                i
                                i
                        pre.code-lines
                            span.dim 01
                            |   
                            span.orange const
                            |  developer = {
                            br
                            span.dim 02
                            |     
                            span.blue frontend
                            | : 
                            span.lime "React"
                            | ,
                            br
                            span.dim 03
                            |     
                            span.blue backend
                            | : [
                            span.lime "Python"
                            | , 
                            span.lime ".NET"
                            | ],
                            br
                            span.dim 04
                            |     
                            span.blue focus
                            | : 
                            span.lime "end-to-end"
                            | ,
                            br
                            span.dim 05
                            |     
                            span.blue mindset
                            | : 
                            span.lime "build with purpose"
                            br
                            span.dim 06
                            |   };
                    span.scene-note Del diseño a producción

        footer.shell
            span Jair Gutierrez
            span Desarrollo frontend · backend
            span 2026